# ==============================================================================
# CareLink AI Healthcare Ecosystem — Environment Configuration
# ==============================================================================

# Server & Port Configuration
PORT=5000
FRONTEND_PORT=3000
NODE_ENV=production

# Database Configuration (Inside Docker Compose, hostname is 'mongodb')
MONGO_URI=mongodb://mongodb:27017/carelink
MONGO_PORT=27017

# Security & Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_change_in_production
SESSION_SECRET=your_super_secret_session_key_change_in_production

# Frontend Client URL (For CORS policies)
CLIENT_URL=http://localhost:3000

# Google OAuth Configuration (Optional - get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Medical Report File Storage Driver (local | s3 | gcs | azure)
STORAGE_DRIVER=local

# AWS S3 Storage (Required only if STORAGE_DRIVER=s3)
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Cloud Storage (Required only if STORAGE_DRIVER=gcs)
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# Azure Blob Storage (Required only if STORAGE_DRIVER=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=
